{
  "buildCommand": "bash prebuild.sh",
  "outputDirectory": ".",
  "installCommand": "npm install --prefix frontend && pip install -r requirements.txt",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
