{
  "buildCommand": "bash prebuild.sh",
  "outputDirectory": ".",
  "installCommand": "npm install --prefix frontend",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
